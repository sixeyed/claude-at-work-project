# CollabHub — local development environment.
# Copy to .env (gitignored) and adjust. Nothing here is a real secret.
#
# Vars are drawn from docs/design/00-platform-conventions.md §8 and the per-service
# "Configuration" sections in docs/design/01-06.
#
# NOTE: the design docs specify no port numbers. The values below are this file's
# choice, and docker-compose.yml should follow them.

# ---------------------------------------------------------------------------
# Common — every service (Conventions §8)
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=debug

AUTH_ISSUER=http://localhost:8001
AUTH_AUDIENCE=collabhub
AUTH_JWKS_URL=http://auth:8000/.well-known/jwks.json

# Service tokens for internal calls (Conventions §5.5). Each service that makes
# internal calls gets its own client credential; scopes are granted by Auth.
AUTH_INTERNAL_AUDIENCE=collabhub-internal
SERVICE_TOKEN_URL=http://auth:8000/api/v1/auth/service-token
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---------------------------------------------------------------------------
# Service ports (host side)
# ---------------------------------------------------------------------------
AUTH_PORT=8001
MESSAGING_PORT=8002
CANVAS_PORT=8003
ASSET_PORT=8004
WORKER_PORT=8005          # health endpoints only; the Worker exposes no API
FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
# PostgreSQL — one database per service, never a shared schema (Conventions §3)
# ---------------------------------------------------------------------------
POSTGRES_USER=collabhub
POSTGRES_PASSWORD=collabhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_auth
MESSAGING_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_messaging
CANVAS_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_canvas
ASSET_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_asset

# ---------------------------------------------------------------------------
# Redis — three logically separate instances, not interchangeable (Conventions §7)
#   R1 cache + token denylist · R2 Socket.IO backplane · R3 job streams
# ---------------------------------------------------------------------------
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_REALTIME_URL=redis://redis-rt:6379/0
REDIS_STREAMS_URL=redis://redis-streams:6379/0

# ---------------------------------------------------------------------------
# Object storage — Garage, S3-compatible, behind the ObjectStore protocol
# ---------------------------------------------------------------------------
OBJECT_STORE_ENDPOINT=http://garage:3900
OBJECT_STORE_ACCESS_KEY=collabhub-local
OBJECT_STORE_SECRET_KEY=collabhub-local-secret
OBJECT_STORE_BUCKET=collabhub-assets
OBJECT_STORE_PRESIGN_TTL_SECONDS=900

# ---------------------------------------------------------------------------
# Elasticsearch — written only by the Worker
# ---------------------------------------------------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---------------------------------------------------------------------------
# Auth service
# ---------------------------------------------------------------------------
# RS256 private key (PEM). Generate a throwaway local pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out auth-local.pem
# Keep it out of git — *.pem is gitignored.
# Leave AUTH_SIGNING_KEY empty locally and the service generates a throwaway key
# at startup — every token then dies with the process, which is fine on a laptop
# and refused outright anywhere else.
AUTH_SIGNING_KEY=
AUTH_PREVIOUS_KEYS=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SERVICE_TOKEN_MINUTES=10
SPA_REDIRECT_URI=http://localhost:5173/auth/callback

# Clients allowed the client-credentials grant (Conventions §5.5), as JSON.
# Keep in step with WORKER_SERVICE_CLIENT_ID / _SECRET below — Auth is the side
# that checks them.
AUTH_SERVICE_CLIENTS=[{"client_id":"worker","secret":"worker-local-secret","scopes":["assets:write-variants"]}]

# The shared workspace every dev-login account joins, so two local users have
# somewhere to meet. Local only, like dev-login itself.
AUTH_DEMO_WORKSPACE_NAME=CollabHub Demo

# Migrations run from the container entrypoint locally. In Kubernetes set this
# false and run `python -m auth.migrate` as a pre-upgrade Job.
RUN_MIGRATIONS=true

# External identity providers — one set per configured provider.
# OIDC_{PROVIDER}_AUTHORITY / _CLIENT_ID / _CLIENT_SECRET, e.g.:
# OIDC_GOOGLE_AUTHORITY=https://accounts.google.com
# OIDC_GOOGLE_CLIENT_ID=
# OIDC_GOOGLE_CLIENT_SECRET=
# SAML_{PROVIDER}_METADATA_URL — SAML support is undecided (register D6).

# ---------------------------------------------------------------------------
# Messaging service
# ---------------------------------------------------------------------------
MESSAGING_MAX_BODY_CHARS=8000
MESSAGING_MAX_ATTACHMENTS=10

# ---------------------------------------------------------------------------
# Canvas service
# ---------------------------------------------------------------------------
CANVAS_SNAPSHOT_INTERVAL_SECONDS=10
CANVAS_SNAPSHOT_EVERY_UPDATES=200
CANVAS_MAX_DOC_BYTES=26214400
CANVAS_AWARENESS_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Asset service
# ---------------------------------------------------------------------------
ASSET_MAX_UPLOAD_BYTES=52428800
ASSET_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/gif,image/webp,image/svg+xml,application/pdf

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# The Worker calls Asset's internal endpoint to report variants, so it needs its
# own service credential (Conventions §5.5). Auth is a runtime dependency.
WORKER_SERVICE_CLIENT_ID=worker
WORKER_SERVICE_CLIENT_SECRET=worker-local-secret
ASSET_INTERNAL_URL=http://asset:8000/api/v1/internal

WORKER_STREAMS=jobs:index,jobs:thumbnail,jobs:notify,jobs:export,jobs:retention
WORKER_MAX_ATTEMPTS=5
WORKER_VISIBILITY_TIMEOUT_SECONDS=60
WORKER_BATCH_SIZE=16
# Retention values are unset in the design docs (register D16) — placeholders.
RETENTION_MESSAGE_DAYS=365
RETENTION_ASSET_PENDING_HOURS=24
# Notification channels for v1 are undecided (register D18); in-app only for now.
NOTIFY_IN_APP_ENABLED=true

# ---------------------------------------------------------------------------
# Frontend (Vite) — not specified in the design docs; these are working defaults.
# Only VITE_-prefixed vars reach the browser bundle. Never put a secret here.
# ---------------------------------------------------------------------------
VITE_AUTH_URL=http://localhost:8001
VITE_MESSAGING_URL=http://localhost:8002
VITE_CANVAS_URL=http://localhost:8003
VITE_ASSET_URL=http://localhost:8004
