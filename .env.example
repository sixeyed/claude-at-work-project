# CollabHub — local development environment.
# Copy to .env (gitignored) and adjust. Nothing here is a real secret.
#
# Vars are drawn from docs/design/00-platform-conventions.md §8 and the per-service
# "Configuration" sections in docs/design/01-06.
#
# NOTE: the design docs specify no port numbers. The values below are this file's
# choice, and docker-compose.yml should follow them.

# ---------------------------------------------------------------------------
# Common — every service (Conventions §8)
# ---------------------------------------------------------------------------
APP_ENV=local
LOG_LEVEL=debug

AUTH_ISSUER=http://localhost:8001
AUTH_AUDIENCE=collabhub
AUTH_JWKS_URL=http://auth:8000/.well-known/jwks.json

# Service tokens for internal calls (Conventions §5.5). Each service that makes
# internal calls gets its own client credential; scopes are granted by Auth.
AUTH_INTERNAL_AUDIENCE=collabhub-internal
SERVICE_TOKEN_URL=http://auth:8000/api/v1/auth/service-token
SERVICE_CLIENT_ID=
SERVICE_CLIENT_SECRET=

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317

# ---------------------------------------------------------------------------
# Service ports (host side)
# ---------------------------------------------------------------------------
AUTH_PORT=8001
MESSAGING_PORT=8002
# Dex's port is not free to change on its own: it appears inside the issuer URL,
# so docker/dex/config.yaml has to change with it. See the Dex section below.
DEX_PORT=5556
CANVAS_PORT=8003
ASSET_PORT=8004
WORKER_PORT=8005          # health endpoints only; the Worker exposes no API
FRONTEND_PORT=5173

# ---------------------------------------------------------------------------
# Acceptance-test stack (docker-compose.test.yml)
# ---------------------------------------------------------------------------
# A second stack that runs alongside the one above, so `uv run pytest tests/bdd`
# does not truncate the channels you created by hand. Only the ports reached
# from the host move; everything else talks over the Compose network by name and
# is not published at all.
#
# These have defaults in docker-compose.test.yml, so they are here to document
# the contract rather than because a local run needs them set. Changing
# BDD_DEX_PORT or BDD_AUTH_PORT means editing docker/dex/config.test.yaml to
# match — an OIDC issuer is an identity, not an address.
BDD_FRONTEND_PORT=5183
BDD_AUTH_PORT=8011
BDD_MESSAGING_PORT=8012
BDD_DEX_PORT=5566
BDD_POSTGRES_PORT=5442
# The browser reaches Asset (upload-url, confirm) and Garage (the presigned PUT and
# GET) directly, so this stack publishes both. Garage's port is also in the
# public endpoint Asset signs URLs for.
BDD_ASSET_PORT=8014
BDD_GARAGE_PORT=3910

# ---------------------------------------------------------------------------
# Build and deploy scripts (scripts/build.sh, scripts/deploy.sh)
# ---------------------------------------------------------------------------
# The scripts read these from the environment, never from this file — they are
# listed to document what CI can override, and commented out so Compose does not
# hand them to every container. Defaults live in scripts/lib/common.sh.
#
# Where images are tagged and pushed. Default: the registry that
# `scripts/deploy.sh cluster` creates. Set it empty for bare collabhub/<name>.
# IMAGE_REGISTRY=localhost:5500
#
# Default: the short commit SHA, plus -dirty for uncommitted changes. Never latest.
# IMAGE_TAG=
#
# The only kubectl context the scripts use. `cluster` and `down` refuse anything
# but the local k3d cluster; `infra` and `app` refuse one that does not match
# DEPLOY_ENV.
# KUBE_CONTEXT=k3d-collabhub
#
# Which charts/*/values-$DEPLOY_ENV.yaml files to install with: k3d or lab.
# DEPLOY_ENV=k3d
#
# One instance per namespace. Several can share a cluster.
# NAMESPACE=collabhub
#
# The origin the browser reaches this instance on. Everything origin-dependent —
# Auth's issuer, the SPA redirect, Dex's issuer, the Ingress host — is derived
# from it. Default http://localhost:8080 on k3d; required for any other
# DEPLOY_ENV.
# APP_ORIGIN=http://a.localhost:8080
#
# The origin the browser uses for object storage, when it is not s3.<APP_ORIGIN
# host>. `scripts/deploy.sh preview` sets it from its second tunnel; leave it unset
# otherwise.
# OBJECT_STORE_ORIGIN=
#
# The branch `scripts/deploy.sh preview` names its namespace after. Default: the
# checked-out branch; required on a detached HEAD.
# BRANCH=
#
# Where previews keep tunnel pids, logs and URLs. Default:
# <git common dir>/collabhub-previews.
# PREVIEW_STATE_ROOT=
#
# Dex's password for this preview, bcrypted into the deps chart. Default: the k3d
# values' shared `collabhub`. A GitHub delivery sets a random one when Slack can carry it.
# PREVIEW_PASSWORD=
#
# The password scripts/smoke.sh signs in with — a preview's own. Default: collabhub.
# Never set it for scripts/test.sh e2e: the test stack's Dex keeps collabhub.
# SMOKE_PASSWORD=

# ---------------------------------------------------------------------------
# PostgreSQL — one database per service, never a shared schema (Conventions §3)
# ---------------------------------------------------------------------------
POSTGRES_USER=collabhub
POSTGRES_PASSWORD=collabhub
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

AUTH_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_auth
MESSAGING_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_messaging
CANVAS_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_canvas
ASSET_POSTGRES_DSN=postgresql+asyncpg://collabhub:collabhub@postgres:5432/collabhub_asset

# ---------------------------------------------------------------------------
# Redis — three logically separate instances, not interchangeable (Conventions §7)
#   R1 cache + token denylist · R2 Socket.IO backplane · R3 job streams
# ---------------------------------------------------------------------------
REDIS_CACHE_URL=redis://redis-cache:6379/0
REDIS_REALTIME_URL=redis://redis-rt:6379/0
REDIS_STREAMS_URL=redis://redis-streams:6379/0

# ---------------------------------------------------------------------------
# Object storage — Garage, S3-compatible, behind the ObjectStore protocol
# ---------------------------------------------------------------------------
OBJECT_STORE_ENDPOINT=http://garage:3900
# What a *browser* can reach Garage on. Presigned URLs are signed for this host
# (the host is part of the signature), while Asset's own calls use the endpoint
# above. The test stack overrides it to http://localhost:3910.
OBJECT_STORE_PUBLIC_ENDPOINT=http://localhost:3900
# Garage will only import a key in its own format: `GK` and 24 hex characters,
# and a 64-hex secret. These are the k3d chart's throwaway values. If your .env was
# copied from an older .env.example it holds `collabhub-local`, which Garage
# refuses — replace both lines with these.
OBJECT_STORE_ACCESS_KEY=GK00000000000000000c011ab0
OBJECT_STORE_SECRET_KEY=00000000000000000000000000000000000000000000000000000000c011ab00
OBJECT_STORE_BUCKET=collabhub-assets
OBJECT_STORE_PRESIGN_TTL_SECONDS=900

# Read by the one-shot `garage-bootstrap` service (charts/collabhub-deps/files/
# garage-bootstrap.py), which assigns the layout, creates the bucket, imports the
# key and sets the bucket's CORS rules. The token is `admin_token` in
# docker/garage/garage.toml.
GARAGE_ADMIN_TOKEN=collabhub-local-admin-token
# Browser origins allowed to PUT to and GET from the bucket, comma-separated.
# The SPA's origin: an empty value leaves the bucket with no CORS rules.
GARAGE_CORS_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# Elasticsearch — written by the Worker, read by Messaging's search route
# ---------------------------------------------------------------------------
ELASTICSEARCH_URL=http://elasticsearch:9200

# ---------------------------------------------------------------------------
# Auth service
# ---------------------------------------------------------------------------
# RS256 private key (PEM). Generate a throwaway local pair with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out auth-local.pem
# Keep it out of git — *.pem is gitignored.
# Leave AUTH_SIGNING_KEY empty locally and the service generates a throwaway key
# at startup — every token then dies with the process, which is fine on a laptop
# and refused outright anywhere else.
AUTH_SIGNING_KEY=
AUTH_PREVIOUS_KEYS=
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=30
AUTH_SERVICE_TOKEN_MINUTES=10
SPA_REDIRECT_URI=http://localhost:5173/auth/callback

# Browser origins allowed to call the services (Conventions §5). Needed locally
# because the SPA is served from :5173 and the APIs from :8001-:8004, which are
# different origins. Deployed behind one ingress they are not, so leave this
# empty there — an empty value installs no CORS middleware at all.
#
# These origins are trusted with *credentials*: the refresh cookie rides on
# requests from them (register D22). Never `*` — a browser refuses that
# combination outright, which is the right instinct made mandatory.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# `Secure` on the refresh cookie. Leave it alone: browsers accept Secure cookies
# on http://localhost, so local development needs no exception, and turning it
# off in a deployed environment puts the session token on the wire in clear.
# AUTH_COOKIE_SECURE=true

# Clients allowed the client-credentials grant (Conventions §5.5), as JSON.
# Keep in step with WORKER_SERVICE_CLIENT_ID / _SECRET and MESSAGING_SERVICE_CLIENT_ID
# / _SECRET below — Auth is the side that checks them.
AUTH_SERVICE_CLIENTS=[{"client_id":"worker","secret":"worker-local-secret","scopes":["assets:write-variants"]},{"client_id":"messaging","secret":"messaging-local-secret","scopes":["assets:claim","assets:download"]}]

# The shared workspace every account joins on first sign-in, so two local users
# have somewhere to meet. Local only — outside APP_ENV=local a new account gets
# only the workspace it owns.
AUTH_DEMO_WORKSPACE_NAME=CollabHub Demo

# Migrations run from the container entrypoint locally. In Kubernetes set this
# false and run `python -m auth.migrate` as a pre-upgrade Job.
RUN_MIGRATIONS=true

# How long the outbound leg of a login may sit half-finished in R1, and how long
# the SPA has to spend the authorization code it gets back. Both are single-use
# keys; these are ceilings, not lifetimes to rely on.
AUTH_LOGIN_STATE_TTL_SECONDS=300
AUTH_CODE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# External identity providers (register D5 — Auth federates, never an OP)
# ---------------------------------------------------------------------------
# One JSON array, not OIDC_{PROVIDER}_AUTHORITY as design doc §6 first had it:
# pydantic-settings cannot discover unknown variable prefixes without a custom
# settings source, and AUTH_SERVICE_CLIENTS above already uses this shape.
#
# Two authorities per provider, and the difference matters:
#   authority          the public URL. It is what goes in the browser redirect
#                      and what the id_token's `iss` must equal.
#   internalAuthority  where *this container* reaches the provider, for
#                      discovery, the token exchange and JWKS.
# They differ locally because the browser cannot resolve `dex` and the Auth
# container cannot resolve its own `localhost`. They differ in any cluster whose
# public hostname is not its in-cluster service name, so this is not a local
# workaround.
OIDC_PROVIDERS=[{"name":"dex","authority":"http://localhost:5556/dex","internalAuthority":"http://dex:5556/dex","clientId":"collabhub-auth","clientSecret":"collabhub-local-secret"}]

# SAML_{PROVIDER}_METADATA_URL — SAML support is undecided (register D6).

# ---------------------------------------------------------------------------
# Dex — the local IdP. Sign in as ada@ / grace@ / alan@collabhub.dev.
# ---------------------------------------------------------------------------
# bcrypt hash of the shared local password, read by `hashFromEnv` in
# docker/dex/config.yaml. This one is for the password "collabhub".
#
# EVERY `$` IS DOUBLED. Compose interpolates variables in this file, so a raw
# bcrypt hash silently loses its salt — `$2b$10$AjNda...` arrives as
# `$2b$10/ZYuD...`, Dex rejects it as a malformed hash, and the error you get is
# a failed login rather than anything pointing here. `$$` escapes to one `$`.
#
# Regenerate with (the output has single `$` — double them before pasting):
#   uv run --with bcrypt --no-project python -c \
#     "import bcrypt;print(bcrypt.hashpw(b'PASSWORD', bcrypt.gensalt(10)).decode())"
DEX_PASSWORD_HASH=$$2b$$10$$AjNda/ZYuDZgz2nQA9lAPOb3Y.uGW4xYCWXG8wTfnyb9KjviceU/S
# Must match `staticClients[0].secret` in docker/dex/config.yaml, which cannot
# read it from the environment.
DEX_CLIENT_SECRET=collabhub-local-secret

# ---------------------------------------------------------------------------
# Messaging service
# ---------------------------------------------------------------------------
MESSAGING_MAX_BODY_CHARS=8000
MESSAGING_MAX_ATTACHMENTS=10
# Messaging claims a send's attachments from Asset with its own service token
# (Conventions §5.5). SERVICE_TOKEN_URL and ASSET_INTERNAL_URL are above and below.
MESSAGING_SERVICE_CLIENT_ID=messaging
MESSAGING_SERVICE_CLIENT_SECRET=messaging-local-secret
# Socket.IO heartbeat — python-socketio's defaults; docker-compose.test.yml shortens both.
MESSAGING_SOCKET_PING_INTERVAL_SECONDS=25
MESSAGING_SOCKET_PING_TIMEOUT_SECONDS=20

# ---------------------------------------------------------------------------
# Canvas service
# ---------------------------------------------------------------------------
CANVAS_SNAPSHOT_INTERVAL_SECONDS=10
CANVAS_SNAPSHOT_EVERY_UPDATES=200
CANVAS_MAX_DOC_BYTES=26214400
CANVAS_AWARENESS_TIMEOUT_SECONDS=30

# ---------------------------------------------------------------------------
# Asset service
# ---------------------------------------------------------------------------
# 50 MiB. The allowed content types are not a setting: the allow-list (no SVG) is
# a constant in asset/rules.py, because it is the whole mitigation for register D15.
ASSET_MAX_UPLOAD_BYTES=52428800

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
# The Worker calls Asset's internal endpoint to report variants, so it needs its
# own service credential (Conventions §5.5). Auth is a runtime dependency.
WORKER_SERVICE_CLIENT_ID=worker
WORKER_SERVICE_CLIENT_SECRET=worker-local-secret
# Asset's origin, with no path: callers append `/api/v1/internal/...` themselves.
# Messaging uses it too, for the claim and download-url calls.
ASSET_INTERNAL_URL=http://asset:8000

# Only streams the Worker has handlers for — it refuses to start otherwise.
# jobs:index is the only one built; add the others as their handlers land.
# Locally one Worker consumes them all; the Helm chart runs KEDA-scaled pools
# instead, each with its own WORKER_STREAMS (register D17, doc 05 §5.3).
WORKER_STREAMS=jobs:index
WORKER_MAX_ATTEMPTS=5
WORKER_VISIBILITY_TIMEOUT_SECONDS=60
WORKER_BATCH_SIZE=16
# Dead-letter entries hold job payloads (message bodies, for jobs:index), so the
# dead stream is capped rather than left to grow.
WORKER_DEAD_LETTER_MAXLEN=10000

# Chart-only — read by KEDA to scale the Worker pools, never by the Worker process,
# which uses REDIS_STREAMS_URL. KEDA's Redis Streams scaler takes host:port and
# cannot parse a redis:// URL. Nothing in docker compose reads these.
REDIS_STREAMS_ADDRESS=redis-streams:6379
REDIS_STREAMS_PASSWORD=
# Retention values are unset in the design docs (register D16) — placeholders.
RETENTION_MESSAGE_DAYS=365
RETENTION_ASSET_PENDING_HOURS=24
# Notification channels for v1 are undecided (register D18); in-app only for now.
NOTIFY_IN_APP_ENABLED=true

# ---------------------------------------------------------------------------
# Frontend (Vite) — not specified in the design docs; these are working defaults.
# Only VITE_-prefixed vars reach the browser bundle. Never put a secret here.
# ---------------------------------------------------------------------------
VITE_AUTH_URL=http://localhost:8001
VITE_MESSAGING_URL=http://localhost:8002
VITE_CANVAS_URL=http://localhost:8003
VITE_ASSET_URL=http://localhost:8004

# ---------------------------------------------------------------------------
# Delivery backend — where the issue-writer skill puts issues, and where
# scripts/deliver.sh fetches them from. Not read by any service. Arguments to the
# `delivery` CLI, the skill or deliver.sh (--backend, --url) win over these.
# ---------------------------------------------------------------------------
# local (docs/issues/NNN.md) or github. A github.com URL alone implies github.
DELIVERY_BACKEND=local
# The repo's web URL for a remote backend, e.g. https://github.com/<owner>/<repo>.
DELIVERY_URL=
# Where scripts/deliver.sh pushes a delivery's branch. Empty: origin for a gh- key,
# forge for an issue- key.
DELIVER_REMOTE=
# 0 commits the branch without fetching or pushing.
DELIVER_PUSH=1
# Epoch seconds: no stage starts with less than the margin (minutes) left. Empty: none.
# The GitHub Actions workflow sets it from the job's start.
DELIVER_DEADLINE=
DELIVER_DEADLINE_MARGIN=75
# 0 opens no PR when a GitHub delivery is accepted.
DELIVER_PR=1
# A Slack bot token (chat:write) and the channel ID (C…): with both, a delivery reports to
# Slack and each preview gets a random password, posted there. Empty: nothing is posted, and
# previews keep the shared `collabhub`.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=
